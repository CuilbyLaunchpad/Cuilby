# Every variable is optional. Copy to .env.local and fill in what you use.
# Robinhood Chain RPC (empty = public endpoint)
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_URL=
# WalletConnect project id from cloud.reown.com (empty = "Not configured on this site yet")
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Practice storage (empty on Vercel = practice shows "not configured yet")
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REDIS_URL=
CHAT_KEY_PREFIX=
# Self-hosted behind your own proxy only: trust x-forwarded-for for rate limits
TRUST_PROXY_HEADERS=
# How many proxies append to x-forwarded-for (default 1: use the rightmost hop)
TRUSTED_PROXY_HOPS=
# Only if your proxy overwrites a client-IP header (for example x-real-ip): name it here
CLIENT_IP_HEADER=
